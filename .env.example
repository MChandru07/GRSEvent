# ---------------------------------------------------------------------------
# Eventora – copy this file to ".env" and edit the values.
#   Copy-Item .env.example .env      (Windows PowerShell)
#   cp .env.example .env             (macOS / Linux)
# ".env" is never served by the website and must not be committed.
# ---------------------------------------------------------------------------

# Flask session signing key – REQUIRED in production.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string
SESSION_HOURS=8
SESSION_COOKIE_SECURE=0
FLASK_DEBUG=0

# MySQL connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123
MYSQL_DATABASE=eventora_db

# Upload limits (megabytes)
MAX_UPLOAD_MB=128
MAX_IMAGE_MB=12
MAX_VIDEO_MB=128

# Optional: used by "python app.py init-db" / "create-admin" to create the
# first administrator without any typing. Leave ADMIN_PASSWORD empty to be
# asked for it (recommended – the password never touches a file).
ADMIN_USERNAME=raj
ADMIN_PASSWORD=kumar123
# Shortest password create-admin accepts. Keep it at 8 (or more) in production;
# lower it only on a private demo machine. This must be <= the length of
# ADMIN_PASSWORD above, otherwise "init-db" silently creates no account and the
# admin login can never succeed.
MIN_PASSWORD_LENGTH=3
